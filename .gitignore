# Publish reviewed project files; keep local production material private.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.nvmrc
!/.env.example
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/LICENSING.md
!/package.json
!/package-lock.json
!/index.html
!/vite.config.js
!/wrangler.jsonc
!/src/
!/public/
!/docs/
!/qa/
!/skills/

# Generated players, guides and examples (npm run build recreates them).
/public/forma/*
!/public/forma/favicon.svg
!/public/forma/backup-library-license.txt
!/public/forma/beta/
/public/forma/beta/*
!/public/forma/beta/video-manifest.json
!/public/forma/beta/en/
/public/forma/beta/en/*
!/public/forma/beta/en/*.mp4
/skills/forma-charts/scripts/agent-api.mjs

# User/developer documentation and notices, not local session reports.
/docs/forma/*
!/docs/forma/licenses/
!/docs/forma/THIRD-PARTY-NOTICES.md
!/docs/forma/SCIENTIFIC-GUIDE.md
!/docs/forma/REFERENCE-NOTES.md

# Portable tests and build helpers; local browser recordings stay local.
/qa/*
!/qa/forma/
/qa/forma/*
!/qa/forma/*.test.mjs
!/qa/forma/payload.mjs
!/qa/forma/delivery-fixtures.mjs
!/qa/forma/route-acceptance.mjs
!/qa/forma/route-acceptance.json
!/qa/forma/audit-capabilities.mjs
!/qa/forma/beta-video-integrity.mjs
!/qa/forma/cloudflare-preflight.mjs

**/node_modules/
**/.DS_Store
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
!/.env.example
**/.dev.vars
**/.dev.vars.*
**/*.pem
**/*.key
**/*.log
**/.vscode/
**/.idea/
